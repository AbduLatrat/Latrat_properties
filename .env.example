# Copy this file to .env and fill values
# SMTP settings (Gmail example: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Admin email to receive booking notifications (defaults to latifyiga193@gmail.com)
ADMIN_EMAIL=latifyiga193@gmail.com

# Optional sync token to protect /sync endpoint. If set, requests must include header X-SYNC-TOKEN
SYNC_TOKEN=

# Server port
PORT=3000
